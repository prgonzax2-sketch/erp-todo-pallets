# Copiar a .env y ajustar valores. No commitear .env.
# Base de datos (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=change_me
DB_NAME=erp_database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=erp_database

# App
PORT=3000
APP_PORT=3000
DB_PORT_PUBLISH=5432
BACKUP_DIRECTORY=/backups
TZ=America/Argentina/Buenos_Aires

# TypeORM: en producción usar migraciones y false (jamás true en prod)
TYPEORM_SYNCHRONIZE=false

# Seguridad (obligatorio): secreto JWT fuerte y privado
JWT_SECRET=change_me_use_strong_random_secret
# CORS restringido por defecto (same-origin). Definir solo si el frontend corre en otro origen.
# CORS_ORIGINS=https://app.ejemplo.com

# Licenciamiento / updates on-prem (Pilar 2 cliente)
# Producción (piloto F5): mantener LICENSE_ENFORCEMENT=grace y UPDATES_AUTO_ENABLED=false.
# NO habilitar auto-update estricto en esta etapa. No commitear claves privadas.
APP_VERSION=0.0.1
LICENSE_SERVER_URL=https://licencias.example.com
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA/haJWv8Qy5YJwT/gZKrB\nVJ2snwn1y3xoRoRz6QQu2sRuT5S/8lag8cm6OjfiOUTi/pXGyPv8hNYiPuEbI50v\na3kUovqOgWJbXo0HNX6dcphm41Z5p4pG9V8ZxFg383ju7NpgxL2QH5n+iTkr2fNp\n5iNepo26P6vDjW8G/0hwzH7X+AbD3/rlfOMUqXj3BosfSqtmBh7S7w3R1nt3dxHo\nJijaJ2jg9TprP+TSrr+bRqQFa+jlSW4ybUHikC3vDhCDDL6Vf8oa6rzW3TMxV9IO\nGN9MpLgAJNf4xIJmzLZf0HJ7WzE6sLKX3Oocd2VX3e4RlV3zjSdL/mtN/bgo48tp\nIbWsp2bBqA2XGfvpRSDDHGslIbbfvDI1g65nf8dOHmxsyGokCOE4AlpuBSo2BjUk\nLI/ioy81C5eSYuN+zUbsGwzxzcf4AEU59upMZ6lFCcADutTCjk3pNSxQ9NSMCFve\nqMTnos6BrGKmMzVGYUR7EHof+hP5IsrzmzeQEwoEYm8ATdyjzPRgJBH37dqecrSz\nqhiN7pJH4qd0h4Zdb8JbwDv8wRk8QIv+eHK+7zZTr/er77VMDZ9Wj9E910KMM8VD\nXSTd7UQ9HfycIyZwvZtBGBGmzdC0Q/cD7U8pYO13FW4M/3l/lDeKCtEkNf4ovU3S\n18uNU/XDvuX9kJQAlwNDRAMCAwEAAQ==\n-----END PUBLIC KEY-----"
LICENSE_ENFORCEMENT=grace
LICENSE_CHECK_INTERVAL_MS=86400000
LICENSE_GRACE_HOURS=72
LICENSE_STATE_PATH=./license
LICENSE_CLOCK_SKEW_SEC=300
UPDATE_CHANNEL=stable
UPDATES_AUTO_ENABLED=false

# Bootstrap admin inicial one-shot (F3.3, opcional)
# Si se configuran y no existe admin sembrado, el backend crea el admin una única vez.
INSTALL_ADMIN_EMAIL=
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_GENERATE_PASSWORD=false



