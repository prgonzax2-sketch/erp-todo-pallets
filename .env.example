# Copiar a .env y ajustar valores. No commitear .env.
# Base de datos (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=change_me
DB_NAME=erp_database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=erp_database

# App
PORT=3000
APP_PORT=3000
DB_PORT_PUBLISH=5432
BACKUP_DIRECTORY=/backups
TZ=America/Argentina/Buenos_Aires

# TypeORM: en producciÃ³n usar migraciones y false (jamÃ¡s true en prod)
TYPEORM_SYNCHRONIZE=false

# Seguridad (obligatorio): secreto JWT fuerte y privado
JWT_SECRET=change_me_use_strong_random_secret
# CORS restringido por defecto (same-origin). Definir solo si el frontend corre en otro origen.
# CORS_ORIGINS=https://app.ejemplo.com

# Licenciamiento / updates on-prem (Pilar 2 cliente)
# Producción (piloto F5): mantener LICENSE_ENFORCEMENT=grace y UPDATES_AUTO_ENABLED=false.
# NO habilitar auto-update estricto en esta etapa. No commitear claves privadas.
# IMPORTANTE (distribución remota): LICENSE_SERVER_URL debe ser la URL HTTPS OFICIAL del servidor de licencias (Auth central), accesible desde clientes.
# NO usar localhost/127.0.0.1/host.docker.internal para instalaciones remotas. Valor actual: prueba local (reemplazar por URL oficial antes de distribuir).
APP_VERSION=v1.0.0
LICENSE_SERVER_URL=http://host.docker.internal:3001
# SIGNING_KID confirmado: prod-20261111 (PEM SPKI abajo corresponde al firmante activo; coherente con JWKS del Auth de la URL configurada)
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAlmRx+IzGkqXSXMTwLCvJ\nsBoAM8T4KZWfLpYZNU/8+Auf7Xt9f1KcsqxJgvlhT3VDi8UDWpVWcNvN0Jr1BdCL\nxh29UKZ1iqyHh7rnq/+yaX5G4QK33F2l2dxxXUImLV7gPRBdGmDcD/r1hraEln7e\ncuuZrdMxWmEinbxiAAJ5e7dCFW4dSoU0FNZHm0IMH+s34qw+NgpHLksC3sHmoMzr\n4JzwFrHAu3afBnD8L3mpM397OgIOM8RUdKVsv6DhGXHFGDkz5UqL9VGugMbslOrU\nKk6BVLykIt9RQdbSTEU5oMHRKPbJcQdACTW_vJTgJrbvRGNint7NmeMRb1A+cvMF\nUwIDAQAB\n-----END PUBLIC KEY-----"
LICENSE_ENFORCEMENT=grace
# Intervalo verificación (ms). SLA indicado: 1800000 (30 min). Mínimo 60000, default histórico 86400000.
LICENSE_CHECK_INTERVAL_MS=1800000
LICENSE_GRACE_HOURS=72
LICENSE_STATE_PATH=./license
LICENSE_CLOCK_SKEW_SEC=300
UPDATE_CHANNEL=stable
UPDATES_AUTO_ENABLED=false

# Bootstrap admin inicial one-shot (F3.3, opcional)
# Si se configuran y no existe admin sembrado, el backend crea el admin una Ãºnica vez.
INSTALL_ADMIN_EMAIL=
INSTALL_ADMIN_PASSWORD=
INSTALL_ADMIN_GENERATE_PASSWORD=false



