# Paquete definitivo de licencias — plantilla de inyección (ERP / Pilar 2)
# Estado: AUTORIZADO A (generado). Completar valores TBD antes de distribuir/integrar como oficial.
# Coherencia obligatoria: LICENSE_SERVER_URL + LICENSE_PUBLIC_KEY_PEM + SIGNING_KID (+ tokens/JWKS) del MISMO entorno Auth.

# --- Valores provistos/autorizados ---
SIGNING_KID=prod-20261111
# Intervalo verificación (ms). SLA indicado: 1800000 (30 min). Mínimo 60000.
LICENSE_CHECK_INTERVAL_MS=1800000

# --- Pendientes de ingreso (Pilar 1/ops) ---
# LICENSE_SERVER_URL: URL HTTPS oficial y alcanzable del Auth (NO localhost/127.0.0.1/host.docker.internal)
LICENSE_SERVER_URL=[INGRESA_AQUI_LA_URL_HTTPS_OFICIAL_DE_AUTH]
# API_ISSUER oficial del entorno Auth (config Auth; referencia de coherencia; no usado por runtime ERP)
API_ISSUER=[INGRESA_EL_ISSUER_OFICIAL]

# --- Clave pública confirmada (SPKI, RS256, kid=prod-20261111) ---
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAlmRx+IzGkqXSXMTwLCvJ\nsBoAM8T4KZWfLpYZNU/8+Auf7Xt9f1KcsqxJgvlhT3VDi8UDWpVWcNvN0Jr1BdCL\nxh29UKZ1iqyHh7rnq/+yaX5G4QK33F2l2dxxXUImLV7gPRBdGmDcD/r1hraEln7e\ncuuZrdMxWmEinbxiAAJ5e7dCFW4dSoU0FNZHm0IMH+s34qw+NgpHLksC3sHmoMzr\n4JzwFrHAu3afBnD8L3mpM397OgIOM8RUdKVsv6DhGXHFGDkz5UqL9VGugMbslOrU\nKk6BVLykIt9RQdbSTEU5oMHRKPbJcQdACTW_vJTgJrbvRGNint7NmeMRb1A+cvMF\nUwIDAQAB\n-----END PUBLIC KEY-----"

# --- Piloto/enforcement (sin cambios estructurales) ---
LICENSE_ENFORCEMENT=grace
LICENSE_GRACE_HOURS=72
LICENSE_CLOCK_SKEW_SEC=300
UPDATES_AUTO_ENABLED=false
UPDATE_CHANNEL=stable
APP_VERSION=v1.0.0

# Checklist antes de integrar como oficial (T1-T2/T6/T7):
# 1) Reemplazar LICENSE_SERVER_URL por HTTPS oficial accesible desde clientes.
# 2) Verificar coherencia PEM/kid con /.well-known/license-jwks.json del Auth en esa URL.
# 3) Confirmar API_ISSUER del entorno y SLA (1800000 ms = 30 min indicado).
# 4) Actualizar .env.example + deploy/docker-compose.prod.yml + docs, recompilar instalador, validar E2E remoto.
